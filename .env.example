# API origin or origin/v1; leave empty for same-origin /v1 requests.
# Public Blux/Privy IDs, chain settings and validation rules come from GET /v1/config.
LUMENRISE_API_URL=http://localhost:5000

# true enables test networks; false (default) exposes mainnets only.
# Applied at build time. Restart dev or rebuild after changing this value.
IS_DEV_MODE=false

# Privy secrets belong to the backend only. No Privy client environment variables are required.
